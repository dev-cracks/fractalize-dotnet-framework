<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Efc.Fractalize.Domain</RootNamespace>
    <Authors>Daniel F Yepes Ortega</Authors>
    <Company>Dev Cracks</Company>
    <PackageId>Efc.Fractalize.Domain</PackageId>
    <Description>Command and query contracts. Brings Efc.Fractalize.Ddd, the common DDD base (entities, aggregate roots, domain events and value objects).</Description>
    <RepositoryUrl>https://github.com/dev-cracks/fractalize-dotnet-framework</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/dev-cracks/fractalize-dotnet-framework</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>dotnet;framework;fractal;architecture;library</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Efc.Fractalize.Ddd\Efc.Fractalize.Ddd.csproj" />
  </ItemGroup>
</Project>
