<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Efc.Fractalize.Infrastructure</RootNamespace>
    <Authors>Daniel F Yepes Ortega</Authors>
    <Company>Dev Cracks</Company>
    <PackageId>Efc.Fractalize.Infrastructure</PackageId>
    <Description>Query dispatcher, the registration of query dispatchers and handlers, and validated configuration sections.</Description>
    <RepositoryUrl>https://github.com/dev-cracks/fractalize-dotnet-framework</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/dev-cracks/fractalize-dotnet-framework</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>dotnet;framework;fractal;architecture;library</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Efc.Fractalize.Application\Efc.Fractalize.Application.csproj" />
    <ProjectReference Include="..\Efc.Fractalize.Domain\Efc.Fractalize.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.15" />
    <PackageReference Include="Scrutor" Version="6.1.0" />
  </ItemGroup>
</Project>
