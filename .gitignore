# =============================================================================
# .gitignore — shared rules for every repository created from this template.
#
# The file covers the operating systems, editors and toolchains we use most, so a
# new repository is safe from day one whatever its stack. Sections for stacks the
# project does not use are harmless; delete them if you prefer a shorter file.
# Monorepos may add a project-level .gitignore next to each project.
# =============================================================================

# --- Operating systems -------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*~
.directory
.Trash-*
.nfs*

# --- Editors and IDEs --------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/
*.swp
*.swo
*.sublime-workspace
.fleet/
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# --- Secrets and local environment (never commit credentials) ---------------
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
secrets.json
*.secret
*.secrets
credentials.json
service-account*.json
.npmrc.local
.netrc
appsettings.*.local.json
*.local.json
.secrets/
local.settings.json

# --- Logs, temporary files and reports ---------------------------------------
*.log
logs/
*.tmp
*.temp
*.bak
*.orig
*.rej
/tmp/
/temp/
coverage/
*.lcov
*.cover
*.coverage
coverage.xml
coverage.out
TestResults/
test-results/
playwright-report/
junit*.xml
*.sarif

